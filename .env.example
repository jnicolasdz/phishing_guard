# Local LLM (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0

# SQLite
DATABASE_PATH=./data/phishing_guard.sqlite3

# IMAP acquisition. Use a dedicated lab mailbox only.
IMAP_HOST=127.0.0.1
IMAP_PORT=993
IMAP_USERNAME=phishing-lab@example.test
IMAP_PASSWORD=replace-me
IMAP_FOLDER=INBOX
IMAP_QUARANTINE_FOLDER=Quarantine
IMAP_SSL=True
IMAP_VALIDATE_CERTS=True
IMAP_IDLE_TIMEOUT=60
IMAP_MARK_SEEN_AFTER_PERSISTENCE=True

# Policy: thresholds are provisional and must be calibrated on labelled data.
PHISHING_AUTO_QUARANTINE=False
PHISHING_RISK_HIGH=0.85
PHISHING_RISK_LOW=0.30
PHISHING_MIN_CONFIDENCE=high

# Limits
MAX_BODY_CHARS=12000
